DATABASE_URL="file:./dev.db"

NEAR_NODE_URL="https://rpc.testnet.near.org"
NEAR_POLICY_CONTRACT_ID="treasury-mesh-hack3rwin.testnet"
NEAR_OWNER_ACCOUNT_ID="treasury-mesh-hack3rwin.testnet"
NEAR_OWNER_PRIVATE_KEY="ed25519:..."

# Required for approval and policy write endpoints. Use at least 32 random
# characters, then enter the same value in Settings > Administrator Access.
TREASURY_ADMIN_TOKEN="replace-with-at-least-32-random-characters"

# Optional upper bound for read-only NEAR view calls (default: 8000 ms).
NEAR_RPC_TIMEOUT_MS="8000"
# Optional upper bound for NEAR write calls (default: 30000 ms). Write calls
# wait for on-chain finality and routinely take 10-25s on testnet — keep
# this well above NEAR_RPC_TIMEOUT_MS or payments will spuriously fail.
NEAR_RPC_WRITE_TIMEOUT_MS="30000"

# Optional: without this, the orchestrator falls back to a regex-based
# intent parser (see src/lib/llm.ts) so the chat still works end-to-end.
# Primary LLM: NEAR AI Cloud (Llama 3.3 70B on TEE)
NEAR_AI_API_KEY="near-ai-..."
NEAR_AI_BASE_URL="https://api.near.ai/v1"
NEAR_AI_MODEL="meta-llama/Llama-3.3-70B-Instruct"

# Alternative LLM: Anthropic Claude
ANTHROPIC_API_KEY="sk-ant-..."
ANTHROPIC_MODEL="claude-haiku-5-5"
